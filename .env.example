# Copy to .env.local and fill in. Never commit .env.local.

# --- Site ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Database ---
# Local dev (SQLite, zero setup):
DATABASE_URL="file:./dev.db"
# Production (Neon / Supabase Postgres) — the provider switches automatically:
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"

# --- Auth (NextAuth) ---
NEXTAUTH_URL="http://localhost:3000"
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET=""
# Credentials login for /admin
ADMIN_EMAIL=""
# Generate with: npm run hash-password -- "your-strong-password"
# In .env files every $ in the hash must be escaped as \$ (the script prints it that way).
ADMIN_PASSWORD_HASH=""
# Optional GitHub OAuth — only this GitHub username may sign in
GITHUB_ID=""
GITHUB_SECRET=""
ADMIN_GITHUB_USERNAME="SimonpeterW"

# --- Email (Resend) ---
RESEND_API_KEY=""
# Must be a verified domain in Resend; onboarding@resend.dev works for testing
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"
CONTACT_TO_EMAIL=""

# --- Image uploads (Cloudinary) ---
# Without these, uploads are saved to public/uploads in development only.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
